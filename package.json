{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "knip": "^6.37.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "dev": "npm run sync-locales && npm run generate-sitemaps && vite",
    "build": "vite build",
    "lint": "eslint .",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "test": "npm run lint && npm run knip && vitest run",
    "deploy": "npm run build && bash scripts/deploy-yos.sh",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules",
    "generate-sitemaps": "node src/utils/generateSitemaps.js",
    "sync-locales": "node src/utils/syncLocales.js",
    "generate-locale-folders": "node src/utils/generateLocaleFolders.js",
    "generate-locale-dictionaries": "node src/utils/generateLocaleDictionaries.js",
    "prebuild": "npm run sync-locales && npm run generate-sitemaps && npm run generate-locale-dictionaries",
    "postbuild": "npm run generate-locale-folders"
  },
  "knip": {
    "ignore": [
      "src/showcase.jsx"
    ]
  }
}
